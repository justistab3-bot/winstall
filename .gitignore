scripts/.fixtures.json
screenshots/ui-report.txt

# 随包分发的 platform-tools
# 这是 Google 的二进制（约 8MB），不适合入库。
# 用 npm run fetch-platform-tools 从本机 Android SDK 复制，
# 或直接下载：https://developer.android.com/tools/releases/platform-tools
resources/platform-tools/

# TypeScript 增量构建缓存
*.tsbuildinfo
